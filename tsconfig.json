{
  "compilerOptions": {
    "alwaysStrict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "node",
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ],
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": ["app"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "noEmitHelpers": false
    }
  }
}
